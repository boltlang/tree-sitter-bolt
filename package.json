{
  "name": "tree-sitter-bolt",
  "version": "0.1.0",
  "description": "Bolt grammar for tree-sitter",
  "repository": "https://github.com/boltlang/tree-sitter-bolt",
  "license": "MIT",
  "author": {
    "name": "Sam Vervaeck",
    "email": "samvv@pm.me"
  },
  "contributors": [
    {
      "name": "Maxim Sokolov",
      "email": "maxim0xff@gmail.com"
    },
    {
      "name": "Max Brunsfeld",
      "email": "maxbrunsfeld@gmail.com"
    },
    {
      "name": "Amaan Qureshi",
      "email": "amaanq12@gmail.com"
    }
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "bolt"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "eslint-config-treesitter": "^1.0.2",
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "^0.27.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "lint": "eslint grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "allowScripts": {
    "tree-sitter-cli@0.27.1": true,
    "tree-sitter@0.25.1": true
  }
}
